# ---------------------------------------------------------------------------
# GuestFlow — Kopiervorlage für die Konfiguration.
# Echte Werte gehören in .env (steht in .gitignore und wird nie committet).
# Einmalig erzeugen lassen:  ./scripts/init-env.sh
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# docker-compose.yml setzt die Verbindungsadresse zur Laufzeit aus diesen drei
# Werten zusammen. Dadurch steht die vollständige Adresse inklusive Passwort
# nirgends in einer versionierten Datei.
POSTGRES_DB=guestflow
POSTGRES_USER=guestflow
POSTGRES_PASSWORD=

# --- Zugang Team-Bereich ---------------------------------------------------
# Passwort für /admin. Bitte lang und zufällig wählen.
ADMIN_PASSWORD=

# Signiert das Session-Cookie. Mindestens 32 zufällige Zeichen.
# Wird der Wert geändert, sind alle angemeldeten Sessions sofort ungültig.
SESSION_SECRET=

# --- Betrieb ---------------------------------------------------------------
# Port, unter dem die Anwendung auf dem Host erreichbar ist.
APP_PORT=3000

# Öffentliche Adresse der Instanz (nur für Hinweise im Team-Bereich).
APP_URL=http://localhost:3000

# --- Lokale Entwicklung ohne Docker ----------------------------------------
# Im Container setzt docker-compose.yml DB_HOST/DB_PORT/DB_NAME/DB_USER/
# DB_PASSWORD selbst — diese Datei braucht sie dafuer nicht.
# Ausserhalb des Containers (npm run dev, npm run db:migrate, npm run db:seed,
# drizzle-kit) fehlen sie dagegen, und die Anwendung findet keine Datenbank.
# Dann die folgenden Zeilen einkommentieren und ausfuellen (gleiche Werte wie
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD oben).
# Voraussetzung: in docker-compose.yml die auskommentierte "ports"-Zeile des
# db-Service aktivieren, sonst ist Postgres vom Host aus nicht erreichbar.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
