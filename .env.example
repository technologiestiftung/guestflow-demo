# ---------------------------------------------------------------------------
# GuestFlow — Kopiervorlage für die Konfiguration.
# Echte Werte gehören in .env (steht in .gitignore und wird nie committet).
# Einmalig erzeugen lassen:  ./scripts/init-env.sh
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# docker-compose.yml setzt die Verbindungsadresse zur Laufzeit aus diesen drei
# Werten zusammen. Dadurch steht die vollständige Adresse inklusive Passwort
# nirgends in einer versionierten Datei.
POSTGRES_DB=guestflow
POSTGRES_USER=guestflow
POSTGRES_PASSWORD=

# --- Zugang Team-Bereich ---------------------------------------------------
# Passwort für /admin. Bitte lang und zufällig wählen.
ADMIN_PASSWORD=

# Signiert das Session-Cookie. Mindestens 32 zufällige Zeichen.
# Wird der Wert geändert, sind alle angemeldeten Sessions sofort ungültig.
SESSION_SECRET=

# --- Betrieb ---------------------------------------------------------------
# Port, unter dem die Anwendung auf dem Host erreichbar ist.
APP_PORT=3000

# Öffentliche Adresse der Instanz (nur für Hinweise im Team-Bereich).
APP_URL=http://localhost:3000

# Steht ein Reverse Proxy davor, der X-Forwarded-For selbst setzt und vom
# Client mitgeschickte Werte verwirft? Dann "true" - die Mengenbegrenzung
# wirkt dann pro Client-Adresse statt pauschal.
# ACHTUNG: Ohne solchen Proxy unbedingt aus lassen. Sonst darf jeder Client
# seine eigene Kennung frei waehlen und die Begrenzung ist wirkungslos.
# Fuer den Betrieb hinter Traefik setzt docker-compose.prod.yml den Wert selbst.
TRUST_PROXY=false

# --- Lokale Entwicklung ohne Docker ----------------------------------------
# Im Container setzt docker-compose.yml DB_HOST/DB_PORT/DB_NAME/DB_USER/
# DB_PASSWORD selbst — diese Datei braucht sie dafuer nicht.
# Ausserhalb des Containers (npm run dev, npm run db:migrate, npm run db:seed,
# drizzle-kit) fehlen sie dagegen, und die Anwendung findet keine Datenbank.
# Dann die folgenden Zeilen einkommentieren und ausfuellen (gleiche Werte wie
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD oben).
# Voraussetzung: in docker-compose.yml die auskommentierte "ports"-Zeile des
# db-Service aktivieren, sonst ist Postgres vom Host aus nicht erreichbar.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- Betrieb auf dem Server (docker-compose.prod.yml) ----------------------
# Nur fuer das Deployment noetig, nicht fuer die lokale Entwicklung.
#
# Fertiges Image aus der Registry. Der Workflow veroeffentlicht es unter
# ghcr.io/<owner>/<repo> mit den Tags "latest", "sha-<commit>" und - bei
# Git-Tags wie v1.2.0 - der Versionsnummer.
# GUESTFLOW_IMAGE=ghcr.io/<owner>/<repo>:latest
#
# Oeffentliche Domain der Instanz. Daraus bildet docker-compose.prod.yml
# sowohl die Traefik-Regel als auch APP_URL (immer https).
# APP_DOMAIN=checkin.example.org
#
# Die vorhandene Traefik-Installation. Netzwerknamen pruefen mit
# "docker network ls", Entrypoint und Resolver stehen in deren Konfiguration.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
